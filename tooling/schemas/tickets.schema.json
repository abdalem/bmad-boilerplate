{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["tickets"],
  "properties": {
    "tickets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["path", "markdown"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/tickets/.+\\.md$"
          },
          "markdown": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
